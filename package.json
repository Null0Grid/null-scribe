{
  "name": "null-scribe",
  "productName": "Null Scribe",
  "version": "5.1.1",
  "description": "Record or import a conversation, transcribe it locally and summarize it with your own Ollama server. Your data. Your grid.",
  "main": "src/main/main.js",
  "author": {
    "name": "NULLGRID",
    "email": "volosteele55@proton.me"
  },
  "homepage": "https://nullgrid.dev",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "build:engines": "bash scripts/build-engines.sh",
    "test:recording": "node scripts/test-recording.js",
    "test:budget": "node scripts/test-recording.js examples/budget-meeting/budget_meeting.mp3 examples/budget-meeting/transcript.md",
    "build:audiotap-cross": "python3 -m ziglang c++ -target x86_64-windows-gnu -O2 -std=c++17 -municode native/audiotap/audiotap.cpp -lole32 -lmmdevapi -luuid -o native/audiotap/scribe-audiotap.exe",
    "dist:linux": "electron-builder --linux deb rpm AppImage tar.gz --x64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:msix": "pwsh packaging/msix/build-msix.ps1 -Version %npm_package_version%"
  },
  "dependencies": {
    "docx": "^9.14.0",
    "ffmpeg-static": "^5.2.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.nullgrid.scribe",
    "productName": "Null Scribe",
    "copyright": "Copyright © NULLGRID. All rights reserved.",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "bin/${os}",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage",
        "tar.gz"
      ],
      "category": "Office",
      "maintainer": "NULLGRID <volosteele55@proton.me>",
      "synopsis": "On-device transcription and AI summaries",
      "description": "Record or import conversations, transcribe them locally with whisper.cpp and get an AI summary from a built-in model. Part of the Null Grid suite.",
      "icon": "build/icon.png",
      "executableName": "null-scribe",
      "artifactName": "null-scribe_${version}_${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libasound2 | libasound2t64",
        "libxss1",
        "libxtst6",
        "xdg-utils"
      ],
      "recommends": [
        "pipewire-bin",
        "libsecret-1-0"
      ]
    },
    "rpm": {
      "artifactName": "null-scribe-${version}.x86_64.rpm",
      "fpm": [
        "--rpm-tag",
        "Recommends: pipewire-utils",
        "--rpm-tag",
        "Recommends: libsecret"
      ]
    },
    "appImage": {
      "artifactName": "NullScribe-${version}-x86_64.AppImage"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "NullScribe-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Null Scribe"
    },
    "executableName": "NullScribe",
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Null0Grid/null-scribe.git"
  }
}
