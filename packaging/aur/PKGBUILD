# Maintainer: NULLGRID <volosteele55@proton.me>
# Template: scripts/render-packaging.js fills in the version, sources and checksums for each release.
pkgname=null-scribe-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Transcribe conversations and get AI summaries on your device (Null Grid)"
arch=('x86_64' 'aarch64')
url="https://github.com/Null0Grid/null-scribe"
license=('LicenseRef-NULLGRID')
depends=('gtk3' 'nss' 'alsa-lib' 'libxss' 'libxtst' 'libnotify' 'at-spi2-core' 'xdg-utils')
optdepends=('pipewire: Meeting mode (record chosen apps)'
            'libsecret: keep the Null Drive token in the system keyring')
provides=('null-scribe')
conflicts=('null-scribe')
options=('!strip' '!debug')
source=(@SOURCE@)
source_x86_64=(@SOURCE_X64@)
source_aarch64=(@SOURCE_ARM64@)
sha256sums=(@SHA_COMMON@)
sha256sums_x86_64=(@SHA_X64@)
sha256sums_aarch64=(@SHA_ARM64@)

package() {
  install -d "$pkgdir/opt/null-scribe"
  cp -a "$srcdir"/null-scribe_"${pkgver}"_*/. "$pkgdir/opt/null-scribe/"
  chmod 4755 "$pkgdir/opt/null-scribe/chrome-sandbox"

  install -d "$pkgdir/usr/bin"
  ln -s /opt/null-scribe/null-scribe "$pkgdir/usr/bin/null-scribe"

  install -Dm644 "$srcdir/null-scribe.png" "$pkgdir/usr/share/pixmaps/dev.nullgrid.scribe.png"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/dev.nullgrid.scribe.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Null Scribe
GenericName=Transcription and AI summaries
Comment=Record or import conversations, transcribe them on your device and get an AI summary
Exec=null-scribe %U
Icon=dev.nullgrid.scribe
Terminal=false
Categories=Office;AudioVideo;Audio;
StartupWMClass=Null Scribe
EOF
}
